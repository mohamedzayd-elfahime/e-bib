APP_NAME=e-bib
ENV=development
DEBUG=true
BASE_URL=http://localhost:8000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=e_bib
DB_USER=root
DB_PASSWORD=change-me

PASSWORD_HASH_ALGO=argon2
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4
PASSWORD_PEPPER=change-me

JWT_ALG=HS256
JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

SESSION_SECRET_KEY=change-me
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

CSRF_HEADER_NAME=X-CSRF-Token
CSRF_TOKEN_TTL_SECONDS=3600

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

WS_PATH=/ws/notifications
WS_HEARTBEAT_SECONDS=30

LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=false

RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_RESERVATION_PER_MINUTE=10
RATE_LIMIT_REVIEW_PER_MINUTE=10

SCHEDULER_ENABLED=false
OVERDUE_CHECK_INTERVAL_MINUTES=60
RESERVATION_EXPIRATION_INTERVAL_MINUTES=60
